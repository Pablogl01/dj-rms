{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djramos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Todo pasa por el worker (redirección www → apex); lo estático se sirve con env.ASSETS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djramos",
      "database_id": "78e90cb1-165c-424d-a45a-99cff6a41277"
    }
  ],
  "vars": {
    // Orígenes extra admitidos además del propio (dominio personalizado).
    "ALLOWED_ORIGINS": "https://djramos.es,https://www.djramos.es"
  }
  // Secretos (wrangler secret put): WEB3FORMS_ACCESS_KEY
}
