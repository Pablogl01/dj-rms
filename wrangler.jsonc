{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djramos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Mantener también la URL djramos.pgl-dev.workers.dev junto al dominio propio.
  "workers_dev": true,
  // Todo pasa por el worker (redirección www → apex); lo estático se sirve con env.ASSETS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Dominio propio (zona djramos.es en la misma cuenta). www redirige al apex desde el worker.
  "routes": [
    { "pattern": "djramos.es", "custom_domain": true },
    { "pattern": "www.djramos.es", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djramos",
      "database_id": "78e90cb1-165c-424d-a45a-99cff6a41277"
    }
  ],
  "vars": {
    // Orígenes extra admitidos además del propio (dominio personalizado).
    "ALLOWED_ORIGINS": "https://djramos.es,https://www.djramos.es"
  }
}
