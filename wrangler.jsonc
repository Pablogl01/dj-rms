{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djramos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // djramos.es lo sirve Netlify (DNS en modo "solo DNS", fuera de las IPs de Cloudflare
  // que LaLiga bloquea). Netlify reenvía /api/* a esta URL workers.dev (netlify.toml).
  "workers_dev": true,
  // Lo estático se sigue sirviendo aquí para workers.dev y desarrollo local.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djramos",
      "database_id": "78e90cb1-165c-424d-a45a-99cff6a41277"
    }
  ],
  "vars": {
    // Orígenes admitidos además del propio: la web en Netlify llega con Origin djramos.es.
    // Secreto aparte (wrangler secret put NETLIFY_PROXY_SECRET): mismo valor que en Netlify.
    "ALLOWED_ORIGINS": "https://djramos.es,https://www.djramos.es"
  }
}
